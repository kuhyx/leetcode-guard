[Unit]
Description=Credit LeetCode solves made while no lock window is up

[Service]
Type=oneshot
# No WorkingDirectory / PYTHONPATH, for the same reason as leetcode-guard.service:
# leetcode_guard is installed into the user site-packages, so plain
# /usr/bin/python3 finds it, and a WorkingDirectory would make whatever branch
# happens to be checked out into the live deployment.
#
# Added 2026-10-17: credits used to be minted only by the lock's poll loop, so
# five solves made on a sick day (no window up) were never credited. The run
# stands aside while a lock is up and never holds the instance lock; see the
# _harvest_run docstring for the four rules.
ExecStart=/usr/bin/python3 -m leetcode_guard._harvest_run
